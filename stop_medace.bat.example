@echo off
setlocal
TITLE MedAce Stopper
echo =================================================
echo   Stopping MedAce Environment...
echo =================================================

:: 1. Stop Tailscale Funnel
echo [1/3] Stopping Tailscale Funnel...
tailscale funnel --https=443 off
timeout /t 2 /nobreak >nul
echo     Done.

:: 2. Stop Uvicorn on port 8000
echo [2/3] Stopping MedAce Backend on port 8000...
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":8000" ^| findstr "LISTENING"') do (
    echo     Found process on port 8000 with PID %%a
    taskkill /PID %%a /F /T
)
wmic process where "commandline like '%%port 8000%%'" delete >nul 2>&1
wmic process where "commandline like '%%--port=8000%%'" delete >nul 2>&1
echo     Done.

:: 3. Stop Caddy only if no other projects need it
:: Adjust the port check below if you have other services using Caddy
echo [3/3] Checking if Caddy is still needed...
netstat -ano | findstr ":YOUR_OTHER_SERVICE_PORT" | findstr "LISTENING" >nul
if "%ERRORLEVEL%"=="1" (
    echo     No other services running, stopping Caddy...
    taskkill /IM caddy.exe /F
    echo     Caddy stopped.
) else (
    echo     Other services still running, leaving Caddy alive...
)

echo.
echo MedAce fully stopped.
echo    - Uvicorn on port 8000: stopped
echo    - Tailscale Funnel: off
echo.
echo Press any key to close this window...
pause >nul
