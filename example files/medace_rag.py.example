from langchain_community.document_loaders import PyPDFLoader, DirectoryLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter
from langchain_chroma import Chroma
from langchain_ollama import OllamaEmbeddings, ChatOllama
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser
from langchain_core.runnables import RunnablePassthrough
import shutil, os

# --- 1. Load and Split the Medical Data ---
# Replace YOUR_DATASET_PATH with the full path to the folder containing your PDFs
# Example (Windows): r"C:\Users\YourName\Documents\MedicalDataset"
# Example (Mac/Linux): "/home/yourname/MedicalDataset"
print("Loading and splitting documents...")
loader = DirectoryLoader(
    r"YOUR_DATASET_PATH",
    glob="**/*.pdf",
    loader_cls=PyPDFLoader
)
docs = loader.load()
print(f"Successfully loaded {len(docs)} pages across all documents.")

text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=1000,
    chunk_overlap=200
)
splits = text_splitter.split_documents(docs)

# --- 2. Create the Vector Database ---
print("Embedding documents and building Vector Database...")
embeddings = OllamaEmbeddings(model="nomic-embed-text")

# Clear existing database to avoid duplicate entries on re-run
if os.path.exists("./chroma_db"):
    shutil.rmtree("./chroma_db")

vectorstore = Chroma.from_documents(
    documents=splits,
    embedding=embeddings,
    persist_directory="./chroma_db"
)

retriever = vectorstore.as_retriever(search_kwargs={"k": 5})

# --- 3. Set up the LLM and Prompt ---
llm = ChatOllama(model="llama3.2:latest", temperature=0)

template = """You are MedAce, an AI assistant providing in-depth information on medical topics. 
Use the following pieces of retrieved context to answer the question. 
If you don't know the answer, just say that you don't know. 
Do not provide official medical diagnoses.

Context: {context}

Question: {question}

Answer:"""
prompt = ChatPromptTemplate.from_template(template)

# --- 4. Build the RAG Chain ---
def format_docs(retrieved_docs):
    return "\n\n".join(doc.page_content for doc in retrieved_docs)

rag_chain = (
    {"context": retriever | format_docs, "question": RunnablePassthrough()}
    | prompt
    | llm
    | StrOutputParser()
)

# --- 5. Test the Pipeline ---
question = "What are the physiological mechanisms detailed in the text?"
print(f"\nQuerying MedAce: {question}\n")
response = rag_chain.invoke(question)
print(response)
