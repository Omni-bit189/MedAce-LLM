@echo off
TITLE MedAce Launcher 🚀
echo =================================================
echo   Starting MedAce Environment... 🩺💻
echo =================================================

:: 1. Check if Docker is already running
echo [1/5] 🐳 Checking Docker engine status...
docker info >nul 2>&1
if %errorlevel% equ 0 (
    echo       Docker is already running.
    goto START_SEARXNG
)

echo       Docker is off. Waking up Docker Desktop...
start "" "C:\Program Files\Docker\Docker\Docker Desktop.exe"
echo       Waiting for engine to boot (this usually takes 10-20 seconds)...

:WAIT_LOOP
timeout /t 5 /nobreak >nul
docker info >nul 2>&1
if %errorlevel% neq 0 goto WAIT_LOOP
echo       Docker engine is now online!

:START_SEARXNG
:: 2. Start the local SearXNG search API container
echo.
echo [2/5] 🔍 Starting SearXNG container (Port 8888)...
docker start medace-search

:: 3. Start Tailscale Funnel
echo.
echo [3/5] 📡 Waking up Tailscale...
start "" cmd /k "tailscale funnel --https=443 http://localhost:8080"
timeout /t 3 /nobreak >nul

:: 4. Start Uvicorn for MedAce on port 8000
echo.
echo [4/5] 🐍 Firing up Uvicorn Backend...
:: REPLACE 'YOUR_BACKEND_PATH' WITH THE ACTUAL PATH TO YOUR API.PY FOLDER
start "" cmd /k "cd YOUR_BACKEND_PATH && uvicorn api:app --reload --host 127.0.0.1 --port 8000"

:: 5. Start Caddy only if it's not already running
echo.
echo [5/5] 🚦 Checking Caddy Server...
tasklist /FI "IMAGENAME eq caddy.exe" 2>NUL | find /I /N "caddy.exe">NUL
if "%ERRORLEVEL%"=="1" (
    echo     Caddy not running, starting it now...
    :: REPLACE 'YOUR_CADDY_PATH' WITH THE ACTUAL PATH TO YOUR CADDY SERVER FOLDER
    start "" cmd /k "cd YOUR_CADDY_PATH && caddy run --config Caddyfile"
) else (
    echo     Caddy already running, skipping...
)

echo.
echo ✅ MedAce is GO!
echo    - SearXNG running on port 8888
echo    - MedAce API running on port 8000
echo    - Caddy proxying on port 8080 via Tailscale Funnel
echo.
echo Press any key to close this window...
pause >nul
exit