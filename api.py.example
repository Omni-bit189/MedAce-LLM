import os
from typing import Optional
import uuid
import tempfile
from fastapi import FastAPI, HTTPException, UploadFile, File, Form
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from langchain_chroma import Chroma
from langchain_ollama import OllamaEmbeddings, ChatOllama
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser
from langchain_core.runnables import RunnablePassthrough, RunnableParallel
from langchain_community.document_loaders import PyPDFLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter

app = FastAPI(title="MedAce API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# --- 1. Global Setup (Loads once on startup) ---
print("Initializing MedAce backend...")
embeddings = OllamaEmbeddings(model="nomic-embed-text")

# Permanent vectorstore from your medical dataset (persisted on disk)
# Make sure you have run medace_rag.py first to generate the chroma_db folder
permanent_vectorstore = Chroma(
    persist_directory="./chroma_db",
    embedding_function=embeddings
)
permanent_retriever = permanent_vectorstore.as_retriever(
    search_type="similarity_score_threshold",
    search_kwargs={"k": 5, "score_threshold": 0.6}
)

# Session stores for uploaded documents (in-memory only, cleared on restart)
session_stores: dict[str, dict] = {}

text_splitter = RecursiveCharacterTextSplitter(chunk_size=1000, chunk_overlap=200)

template = """You are MedAce, an AI assistant specializing in medical topics.
You have access to a medical knowledge base. Use the retrieved context below if it is relevant to the question.
If the context is not relevant or the question is general, answer using your own knowledge as a helpful AI assistant.
Never tell the user you are limited to a dataset or cannot answer — just respond helpfully.

Context: {context}

Question: {question}

Answer:"""
prompt = ChatPromptTemplate.from_template(template)

def format_docs(docs):
    return "\n\n".join(doc.page_content for doc in docs)

def get_combined_docs(question: str, session_id: str = None) -> list:
    """Retrieve from permanent DB, and also from session DB if one exists."""
    permanent_docs = permanent_retriever.invoke(question)

    session_docs = []
    if session_id and session_id in session_stores:
        session_retriever = session_stores[session_id]["vectorstore"].as_retriever(
            search_kwargs={"k": 5}
        )
        session_docs = session_retriever.invoke(question)

    return permanent_docs + session_docs

# --- 2. Request Models ---
class QueryRequest(BaseModel):
    question: str
    model: str = "llama3.2:latest"
    session_id: Optional[str] = None

class SessionRequest(BaseModel):
    session_id: str

# --- 3. Upload Endpoint ---
@app.post("/upload")
async def upload_document(
    file: UploadFile = File(...),
    session_id: str = Form(None)
):
    if not file.filename.endswith(".pdf"):
        raise HTTPException(status_code=400, detail="Only PDF files are supported.")

    if not session_id:
        session_id = str(uuid.uuid4())

    try:
        with tempfile.NamedTemporaryFile(delete=False, suffix=".pdf") as tmp:
            contents = await file.read()
            tmp.write(contents)
            tmp_path = tmp.name

        loader = PyPDFLoader(tmp_path)
        docs = loader.load()
        splits = text_splitter.split_documents(docs)

        for doc in splits:
            doc.metadata["source"] = file.filename

        os.unlink(tmp_path)

        if session_id not in session_stores:
            session_stores[session_id] = {
                "vectorstore": Chroma(embedding_function=embeddings),
                "files": []
            }

        session_stores[session_id]["vectorstore"].add_documents(splits)

        if file.filename not in session_stores[session_id]["files"]:
            session_stores[session_id]["files"].append(file.filename)

        print(f"Session {session_id}: uploaded '{file.filename}' ({len(splits)} chunks)")

        return {
            "session_id": session_id,
            "filename": file.filename,
            "chunks": len(splits),
            "files_in_session": session_stores[session_id]["files"]
        }

    except Exception as e:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        print(f"Upload error: {e}")
        raise HTTPException(status_code=500, detail=str(e))


# --- 4. Clear Session Endpoint ---
@app.post("/clear-session")
async def clear_session(request: SessionRequest):
    if request.session_id in session_stores:
        del session_stores[request.session_id]
        print(f"Session {request.session_id} cleared.")
        return {"message": "Session cleared successfully."}
    return {"message": "Session not found — nothing to clear."}


# --- 5. Ask Endpoint ---
@app.post("/ask")
async def ask_medace(request: QueryRequest):
    try:
        print(f"Received query. Model: {request.model} | Session: {request.session_id}")

        combined_docs = get_combined_docs(request.question, request.session_id)

        print(f"\n--- RETRIEVED CHUNKS: {len(combined_docs)} ---")
        for doc in combined_docs:
            print(f"Source: {doc.metadata.get('source')} | Page: {doc.metadata.get('page')}")
        print("-------------------------------\n")

        llm = ChatOllama(model=request.model, temperature=0)
        context_text = format_docs(combined_docs)

        chain = prompt | llm | StrOutputParser()
        answer = chain.invoke({"context": context_text, "question": request.question})

        sources = []
        for doc in combined_docs:
            sources.append({
                "file": os.path.basename(doc.metadata.get("source", "Unknown")),
                "page": doc.metadata.get("page", "Unknown")
            })

        return {
            "answer": answer,
            "sources": sources
        }

    except Exception as e:
        print(f"Error during generation: {e}")
        raise HTTPException(status_code=500, detail=str(e))
